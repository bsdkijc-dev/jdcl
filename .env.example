# JDCL v1.0 Environment Configuration (Zero-Cost Local Mode)
# Copy to .env locally if overriding defaults. NEVER commit .env or credentials.

JDCL_ENV=local
JDCL_SEED=20270101
JDCL_DATASET_ROWS=10000
JDCL_DATA_DIR=data
JDCL_JPAIS_MODE=offline_local
JDCL_JPAIS_STORE_DIR=artifacts/jpais_store
JDCL_ALLOW_EXTERNAL_PUBLISH=false

# Optional Kaggle local CLI (human-gated only; never commit real values)
# KAGGLE_USERNAME=
# KAGGLE_KEY=
